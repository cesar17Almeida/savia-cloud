# Production environment -- install as /etc/savia-cloud/env (chmod 600, owner savia).
# Loaded by systemd (EnvironmentFile), NOT by the app itself. systemd keeps
# everything after '=' verbatim, so a comment never goes on a value line.

TTN_BASE_URL=https://eu1.cloud.thethings.network
TTN_APP_ID=savia
# AS API key with downlink rights.
TTN_API_KEY=

STATION_LAT=39.47
STATION_LON=-0.38

# PostgreSQL on the same host, Unix socket + peer auth (OS user `savia` == DB role).
DATABASE_URL=postgresql+psycopg://savia@/savia?host=/var/run/postgresql
# Password alternative (needs scram-sha-256 for 127.0.0.1 in pg_hba.conf):
# DATABASE_URL=postgresql+psycopg://savia:CHANGE_ME@127.0.0.1:5432/savia

# X-Webhook-Token expected on POST /ttn/uplink.
WEBHOOK_SECRET=
# X-Cron-Token expected on POST /cron/daily.
CRON_SECRET=
# LOCAL hour each FORWARD station runs its daily inference.
CRON_DAILY_HOUR=6

MODEL_PATH=/opt/savia-cloud/models/lstm_hs30_int8_pt.tflite

HOST=127.0.0.1
PORT=8000

# Flask session-cookie signing key for the web panel (openssl rand -hex 32).
SECRET_KEY=
# The panel is served over HTTPS: never send its cookie in clear.
SESSION_COOKIE_SECURE=true
# Initial password of the panel operator `admin` (used only when the account is
# created). Empty = "admin", which the panel forces to change on first login.
ADMIN_PASSWORD=
# Self-service POST /auth/register stays closed unless set to true.
ALLOW_REGISTRATION=false
