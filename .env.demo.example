# Link over HTTP: the phone tunnels the station's LoRa frames (see DEMO.md).
# Copy to .env.demo (make demo does it on first run).
# Keep comments on their own line: systemd's EnvironmentFile keeps them in the value.

# Local SQLite file; `make demo-reset` deletes it.
DATABASE_URL=sqlite:///demo.db

# Station link: POST /link/uplink instead of TTN, downlinks answered in the same call.
LINK_MODE=http
# X-Link-Token expected on POST /link/uplink; empty = no check.
LINK_SECRET=

# Air temperature served from the LSTM training set instead of Open-Meteo.
FORECAST_SOURCE=dataset
# UTC offset (min) that anchors the training-set hours to the clock. Must equal the
# firmware's SAVIA_DEMO_UTC_OFFSET_MIN; 120 = Spanish summer time.
REPLAY_UTC_OFFSET_MIN=120

# Unused machine-to-machine endpoints stay open on the LAN.
WEBHOOK_SECRET=
CRON_SECRET=

# Panel operator `admin`; set, so the forced password change does not appear.
ADMIN_PASSWORD=savia-panel-2026

# HTTP server, reachable from the phone on the same network.
HOST=0.0.0.0
PORT=8000
