# The Things Stack (eu1 cluster) -- application "savia".
TTN_BASE_URL=https://eu1.cloud.thethings.network
TTN_APP_ID=savia
TTN_API_KEY=            # AS API key with downlink rights (keep secret)

# Default station location for the Open-Meteo forecast (Valencia by default).
STATION_LAT=39.47
STATION_LON=-0.38

# Persistence (SQLAlchemy URL). Default: a local SQLite file.
DATABASE_URL=sqlite:///savia.db

# Shared secrets for the machine-to-machine endpoints.
WEBHOOK_SECRET=         # X-Webhook-Token expected on POST /ttn/uplink
CRON_SECRET=            # X-Cron-Token expected on POST /cron/daily
CRON_DAILY_HOUR=6       # LOCAL hour each FORWARD station runs its daily inference

# Cloud FORWARD inference model (same file the firmware embeds).
MODEL_PATH=/Users/calmeida/Documents/UPV_2025/TFM/docs/sensor_documentation/model/modelo_lstm/lstm_hs30_int8_pt.tflite

# HTTP server.
HOST=0.0.0.0
PORT=8000
