# Local development environment: copy to .env (make run sources it).
# Keep comments on their own line: systemd's EnvironmentFile keeps them in the value.

# The Things Stack (eu1 cluster) -- application "savia".
TTN_BASE_URL=https://eu1.cloud.thethings.network
TTN_APP_ID=savia
# AS API key with downlink rights (keep secret).
TTN_API_KEY=

# Default station location for the Open-Meteo forecast (Valencia by default).
STATION_LAT=39.47
STATION_LON=-0.38

# Persistence (SQLAlchemy URL). Local development can use a SQLite file.
DATABASE_URL=sqlite:///savia.db

# Shared secrets for the machine-to-machine endpoints.
# X-Webhook-Token expected on POST /ttn/uplink.
WEBHOOK_SECRET=
# X-Cron-Token expected on POST /cron/daily.
CRON_SECRET=
# LOCAL hour each FORWARD station runs its daily inference.
CRON_DAILY_HOUR=6

# Cloud FORWARD inference model (same file the firmware embeds).
MODEL_PATH=/Users/calmeida/Documents/UPV_2025/TFM/docs/sensor_documentation/model/modelo_lstm/lstm_hs30_int8_pt.tflite

# HTTP server.
HOST=0.0.0.0
PORT=8000

# Flask session-cookie signing key for the web panel (openssl rand -hex 32).
SECRET_KEY=
# Initial password of the panel operator `admin`; empty = "admin", forced to change.
ADMIN_PASSWORD=
# Self-service POST /auth/register (closed unless true).
ALLOW_REGISTRATION=true
